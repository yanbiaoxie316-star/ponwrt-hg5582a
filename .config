CONFIG_TARGET_hisilicon=y
CONFIG_TARGET_hisilicon_pon=y
CONFIG_TARGET_hisilicon_pon_DEVICE_fiberhome_hg5382a=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ===== PON 核心驱动（必须保留，PON能否注册全靠这几项）=====
CONFIG_PACKAGE_kmod-hisilicon-gpon=y
CONFIG_PACKAGE_omci=y
CONFIG_PACKAGE_ponwrt-pon=y
CONFIG_PACKAGE_ponwrt-luci-app-pon=y

# LuCI网页管理，包含PON配置页面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-opkg=y

# 网络组件
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_pppoe=y
CONFIG_PACKAGE_swconfig=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ipv6=y

# 系统工具
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_nano=y
